{
  "name": "postfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "node scripts/build.mjs",
    "check:packages": "node scripts/verify-packages.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:boundaries && npm test && npm run build && npm run check:packages"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "addons-linter": "10.14.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
